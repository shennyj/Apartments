# Google Sheets credentials — provide ONE of the following:
# Option A: paste the full service account JSON as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: path to the downloaded service account .json file
GOOGLE_SERVICE_ACCOUNT_FILE=

# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=

# Optional price filters (USD, no $ sign)
MIN_PRICE=
MAX_PRICE=
